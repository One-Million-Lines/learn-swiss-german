# SwissSpeak backend configuration

# Runtime
VT_ENV=development
APP_PORT=5206
APP_HOST=0.0.0.0

# MongoDB (replica set required for transactions; single-node RS is fine locally)
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=swissspeak

# Public URLs / CORS (do not hard-code localhost in production email links)
PUBLIC_WEB_BASE_URL=http://localhost:5306
PUBLIC_API_BASE_URL=http://localhost:5206
ALLOWED_ORIGINS=http://localhost:5306,http://127.0.0.1:5306
ALLOWED_RETURN_PATHS=/auth/callback

# Cookies / auth
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Email adapter: "console" logs the magic link (dev). Wire a real provider for prod.
EMAIL_PROVIDER=console
EMAIL_FROM=SwissSpeak <no-reply@localhost>

# AI / audio providers: "fake" = deterministic, offline, free (dev/tests).
SPEECH_PROVIDER=fake
AI_TEXT_PROVIDER=fake
OPENAI_APIKEY=
ANTHROPIC_API_KEY=
GOOGLE_GENAI_APIKEY=

# Run an in-process audio worker alongside the API (set 0 to run scripts.worker separately)
RUN_INPROCESS_WORKER=1
